/* wifi_credentials.h.example — PLANTILLA.
 *
 * Copia este fichero a "wifi_credentials.h" (ignorado por git, ver .gitignore)
 * y rellena los valores reales del AP de la P4. La clave del AP no se versiona:
 * este repositorio es publico.
 *
 * Sin este fichero el build falla a propósito: no debe compilarse con una
 * contraseña de broma. La única excepción es el CI de GitHub, que copia esta
 * plantilla antes de compilar solo para que el compilador tenga algo que ver
 * (ese CI no publica binarios).
 *
 * OJO: de momento el firmware NO lee la configuración de NVS (está pendiente
 * el módulo de configuración que permita cambiarla desde Ajustes). Hasta
 * entonces, el SSID/clave de aquí son los que usa el firmware.
 */
#pragma once

/* AP de la pantalla del salón (P4): "VictronConfig" con WPA2. */
#define WIFI_CRED_SSID  "VictronConfig"
#define WIFI_CRED_PASS  "CAMBIAME"

/* Usuario y clave del PORTAL de la P4 (no del wifi), para mandarle los apuntes
 * del viaje. FALTABAN EN ESTA PLANTILLA y por eso el CI llevaba desde el 8-oct
 * sin compilar: main/net/p4_creds.c los usa y el CI compila con lo que saque de
 * aqui. Si anades un dato de configuracion nueva, ANADELO TAMBIEN AQUI. */
#define PORTAL_CRED_USER  "CAMBIAME"
#define PORTAL_CRED_PASS  "CAMBIAME"
