# Defaults de cabina5 (ESP32-S3 + panel RGB 800x480 + GT911).
#
# Esto se aplica SOLO al generar sdkconfig desde cero (primer "idf.py build").
# A partir de ahi manda sdkconfig, como en los otros proyectos.

# ── Chip y memoria ──────────────────────────────────────────────────────────
CONFIG_IDF_TARGET="esp32s3"
# La placa trae 16 MB de flash y 8 MB de PSRAM OCTAL (OPI). El modo octal no es
# opcional aqui: el panel RGB lee su framebuffer de la PSRAM sin parar, y con
# PSRAM quad (o sin ella) el panel parpadea y no hay ajuste que lo arregle.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# ── IMPRESCINDIBLE: bootloader de 2a etapa en QIO ───────────────────────────
# Esta placa (ESP32-S3 rev v0.2 + PSRAM octal AP_3v3 8 MB) NO ARRANCA en DIO:
# la PSRAM se inicializa bien, se anade al heap y en el siguiente acceso la
# lectura de flash desde la MSPI compartida se corrompe -> reset silencioso
# (RTC_SW_CPU_RST) en bucle, sin panic. Ver espressif/esp-idf#18806: el unico
# cambio necesario es el MODO de flash (no la velocidad, que ya se probo).
# El sdkconfig generado sigue diciendo CONFIG_ESPTOOLPY_FLASHMODE="dio" y es
# CORRECTO: esptool graba siempre el bootloader en DIO y es la 2a etapa la que
# activa QIO (linea "qio_mode: Enabling default flash chip QIO" del arranque).
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ── Rendimiento (panel RGB + PSRAM compartida) ──────────────────────────────
# Con el panel RGB leyendo de PSRAM sin parar, la cache y el compilador
# importan aqui mas que en otros paneles.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# ── LVGL 8.4 (version fijada a proposito: ver main/idf_component.yml) ─────────
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEM_CUSTOM_INCLUDE="stdlib.h"
CONFIG_LV_DISP_DEF_REFR_PERIOD=30
# FUENTES: esta pantalla tiene 181 ppp (5" a 800x480), asi que las de 14/16 px
# se ven pequenas: el juego va un escalon por encima de lo habitual. Los tamanos
# que se usan de verdad se declaran aqui; si falta uno, salta "undeclared".
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_20=y

# ── Particiones ─────────────────────────────────────────────────────────────
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ── Consola ─────────────────────────────────────────────────────────────────
# OJO: esta placa lleva un CH340 en UART0 (GPIO43/44), no el USB nativo.
# Con USB_SERIAL_JTAG el log de arranque no sale por ningun sitio visible.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
