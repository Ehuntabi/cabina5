# Defaults de cabina5 (ESP32-S3 + panel RGB 800x480 + GT911).
#
# Esto se aplica SOLO al generar sdkconfig desde cero (primer "idf.py build").
# A partir de ahi manda sdkconfig, como en los otros proyectos.

# ── Chip y memoria ──────────────────────────────────────────────────────────
CONFIG_IDF_TARGET="esp32s3"
# La placa trae 16 MB de flash y 8 MB de PSRAM OCTAL (OPI). El modo octal no es
# opcional aqui: el panel RGB lee su framebuffer de la PSRAM sin parar, y con
# PSRAM quad (o sin ella) el panel parpadea y no hay ajuste que lo arregle.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# ── IMPRESCINDIBLE: bootloader de 2a etapa en QIO ───────────────────────────
# Esta placa (ESP32-S3 rev v0.2 + PSRAM octal AP_3v3 8 MB) NO ARRANCA en DIO:
# la PSRAM se inicializa bien, se anade al heap y en el siguiente acceso la
# lectura de flash desde la MSPI compartida se corrompe -> reset silencioso
# (RTC_SW_CPU_RST) en bucle, sin panic. Ver espressif/esp-idf#18806: el unico
# cambio necesario es el MODO de flash (no la velocidad, que ya se probo).
# El sdkconfig generado sigue diciendo CONFIG_ESPTOOLPY_FLASHMODE="dio" y es
# CORRECTO: esptool graba siempre el bootloader en DIO y es la 2a etapa la que
# activa QIO (linea "qio_mode: Enabling default flash chip QIO" del arranque).
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ── Rendimiento (panel RGB + PSRAM compartida) ──────────────────────────────
# Con el panel RGB leyendo de PSRAM sin parar, la cache y el compilador
# importan aqui mas que en otros paneles.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# ── LVGL 9 (version fijada en main/idf_component.yml) ────────────────────────
# OJO con las claves: en LVGL 9 ya no existen LV_MEM_CUSTOM ni
# LV_DISP_DEF_REFR_PERIOD ni LV_COLOR_16_SWAP. El orden de bytes del RGB565 lo
# fija ahora el formato de color del display (LV_COLOR_FORMAT_RGB565), no una
# casilla del Kconfig.
CONFIG_LV_COLOR_DEPTH_16=y
# Pool propio de LVGL (256 KB) en vez de coger del monton general.
# POR QUE: en la 3,5" la UI se crea ANTES que WiFi y da igual de donde salga la
# RAM; en la 5" el BSP necesita ademas el bounce buffer (RAM interna, sin el la
# imagen se corre sola), asi que con CLIB el reparto es una loteria y
# esp_wifi_init() se queda sin memoria ("create wifi task: failed to create
# task"). Con el pool, LVGL se lleva SU trozo de una vez y no toca el monton.
# Asignador propio de LVGL sobre PSRAM: ver main/lv_mem_psram.c (ahi esta la
# cuenta de RAM medida que obliga a esto).
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_DEF_REFR_PERIOD=30
# Captura de pantalla (lv_snapshot_take): la usa el modo de capturas del
# carrusel (ver main/lv_port_compat.c y capture_carousel.c). En LVGL 9 no viene
# activada de serie, y si falta, el build falla con "implicit declaration of
# function 'lv_snapshot_take'".
CONFIG_LV_USE_SNAPSHOT=y
# LVGL 9 necesita saber con que sistema operativo corre (el port de Espressif no
# lo pone solo en el Kconfig del proyecto).
CONFIG_LV_USE_OS=y
CONFIG_LV_OS_FREERTOS=y
# FUENTES: esta pantalla tiene 181 ppp (5" a 800x480) y se mira desde el asiento
# del conductor, no de cerca: el 8-oct-2026 se subio TODA la escala otro escalon
# mas (ver main/ui/estilos.h). Los tamanos que se usan de verdad se declaran
# aqui; si falta uno, salta "undeclared".
# OJO: LVGL no trae Montserrat 56 (llega hasta 48), asi que ese escalon no
# existe: el titular de 48 se queda en 48 a proposito.
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_30=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_34=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_38=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_MONTSERRAT_42=y
CONFIG_LV_FONT_MONTSERRAT_44=y
CONFIG_LV_FONT_MONTSERRAT_46=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_20=y

# ── Particiones ─────────────────────────────────────────────────────────────
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ── Consola ─────────────────────────────────────────────────────────────────
# OJO: esta placa lleva un CH340 en UART0 (GPIO43/44), no el USB nativo.
# Con USB_SERIAL_JTAG el log de arranque no sale por ningun sitio visible.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
