# Defaults de cabina55 (ESP32-S3 + panel RGB 800x480 + GT911).
#
# Esto se aplica SOLO al generar sdkconfig desde cero (primer "idf.py build").
# A partir de ahi manda sdkconfig, como en los otros proyectos.

# ── Chip y memoria ──────────────────────────────────────────────────────────
CONFIG_IDF_TARGET="esp32s3"
# La placa trae 16 MB de flash y 8 MB de PSRAM OCTAL (OPI). El modo octal no es
# opcional aqui: el panel RGB lee su framebuffer de la PSRAM sin parar, y con
# PSRAM quad (o sin ella) el panel parpadea y no hay ajuste que lo arregle.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ── Rendimiento (panel RGB + PSRAM compartida) ──────────────────────────────
# Con el panel leyendo de PSRAM, la cache y el compilador importan: en el 3,5"
# (QSPI) daba igual, aqui no.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# ── LVGL 8.4 (el mismo que el satelite 3,5" y que la P4: no mezclar versiones) ─
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEM_CUSTOM_INCLUDE="stdlib.h"
CONFIG_LV_DISP_DEF_REFR_PERIOD=30
# FUENTES: en la placa de 5" (181 ppp frente a 233 del 3,5") las de 14/16 px se
# ven pequenas, asi que el juego sube un escalon. Los tamanos que se usan de
# verdad se declaran aqui; si falta uno, el enlazador avisa con "undeclared".
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_20=y

# ── Particiones ─────────────────────────────────────────────────────────────
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ── Consola ─────────────────────────────────────────────────────────────────
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
